# Copy to frontend/.env.local for local Vite.
# On Vercel, set these under Project → Settings → Environment Variables.
# Do not put real keys in git.

# Clerk publishable key (safe to expose in the browser, still do not commit the live value)
VITE_CLERK_PUBLISHABLE_KEY=

# Leave unset to use the production FastAPI API.
# Only set this if you are running the backend on your machine.
# VITE_API_URL=http://127.0.0.1:8000
