# Copy this file to backend/.env and fill in values from your own dashboards.
# Never commit backend/.env — it is gitignored.

ENVIRONMENT=production

# Clerk (required to boot)
CLERK_JWKS_URL=https://your-clerk-instance/.well-known/jwks.json
CLERK_JWT_ISSUER=https://your-clerk-instance
CLERK_SECRET_KEY=

# OpenAI — Whisper + GPT
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

# Frontend origins allowed to call this API
ALLOWED_ORIGINS=https://neurativo.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Optional: comma-separated Clerk user IDs for the admin panel
ADMIN_USER_IDS=

# Optional: transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Neurativo <noreply@neurativo.com>

# Optional: Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_STUDENT_PRODUCT_ID=
DODO_PRO_PRODUCT_ID=
DODO_SMALL_PACK_PRODUCT_ID=
DODO_LARGE_PACK_PRODUCT_ID=
DODO_PRO_PACK_PRODUCT_ID=
